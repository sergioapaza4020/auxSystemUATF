DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aux_system_db
# Demo users/enrollments require true AND NODE_ENV=development or test. Never use in production.
SEED_DEMO_DATA=false
# Configure existing API authentication secrets locally; never commit real values.
JWT_ACCESS_SECRET=replace-locally
JWT_ACCESS_REFRESH=replace-locally
JWT_ACCESS_SECRET_EXPIRES_IN=15m
JWT_ACCESS_REFRESH_EXPIRES_IN=7d
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
BULK_USER_IMPORT_BATCH_SIZE=250
BULK_USER_IMPORT_BCRYPT_CONCURRENCY=4
BULK_USER_IMPORT_JOB_CONCURRENCY=1
# Optional: QR alone returns 503 if absent/invalid. Use distinct random keys per environment.
# Key values: canonical standard Base64, 32-128 decoded bytes. Never reuse JWT keys.
# ATTENDANCE_QR_ACTIVE_KID=local-v1
# ATTENDANCE_QR_KEYS_JSON={"local-v1":"<base64-key-configured-outside-git>"}
