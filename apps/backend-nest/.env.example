PORT=
DATABASE_URL=
# Exact browser origin for CORS, without a trailing slash. Use HTTPS in production.
FRONTEND_URL=
# Demo users/enrollments require true AND NODE_ENV=development or test. Never use in production.
SEED_DEMO_DATA=
# Configure existing API authentication secrets locally; never commit real values.
JWT_ACCESS_SECRET=
JWT_ACCESS_REFRESH=
JWT_ACCESS_SECRET_EXPIRES_IN=
JWT_ACCESS_REFRESH_EXPIRES_IN=
# Absolute session limits. Refresh never extends the original deadline.
AUTH_SESSION_TTL=
AUTH_REMEMBERED_SESSION_TTL=
# Same server-side key as Next. Use 32 random bytes encoded as lowercase hex.
AUTH_TRANSPORT_KEY=
# Optional separate key for approved server-side legacy consumers only.
AUTH_LEGACY_TRANSPORT_KEY=
# Can shorten the compatibility window. The hard cutoff is 2026-12-08T00:00:00Z.
AUTH_LEGACY_TRANSPORT_UNTIL=
REDIS_HOST=
REDIS_PORT=
# REDIS_PASSWORD=
BULK_USER_IMPORT_BATCH_SIZE=
BULK_USER_IMPORT_BCRYPT_CONCURRENCY=
BULK_USER_IMPORT_JOB_CONCURRENCY=
# Optional: QR alone returns 503 if absent/invalid. Use distinct random keys per environment.
# Key values: canonical standard Base64, 32-128 decoded bytes. Never reuse JWT keys.
# ATTENDANCE_QR_ACTIVE_KID=
# ATTENDANCE_QR_KEYS_JSON=

# COMB-6: enable only on the existing worker after schema/retention review.
# Bounded 100-row batches every 5 minutes; DB advisory lock coordinates workers.
ATTENDANCE_AUTHORIZATION_CLEANUP_ENABLED=
# Attendance rate limits reuse REDIS_HOST/REDIS_PORT/REDIS_PASSWORD above.
# All API instances MUST use the same isolated Redis store for this environment.

# Fotografías privadas. Usar el endpoint HTTPS y la región de la misma rama Neon.
# Credenciales de esa rama con storage:read y storage:write. Solo en NestJS.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AVATAR_STORAGE_BUCKET=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=

# smtp para Gmail local. https para Resend en Render Free.
MAIL_PROVIDER=smtp
MAIL_TEST_TO=
MAIL_API_KEY=
MAIL_FROM=
# Origen público de Next.js. Si se omite, se usa FRONTEND_URL.
MAIL_VERIFICATION_ORIGIN=

SMTP_USER=
SMTP_PASSWORD=

SMTP_FROM=

# Private recovery-only HMAC key: 32 random bytes encoded as lowercase hex.
PASSWORD_RECOVERY_HMAC_KEY=
# Enable only when Next receives an overwritten client-IP header from a trusted proxy.
PASSWORD_RECOVERY_TRUST_CLIENT_IP=false
