DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aux_system_db
# Configure existing API authentication secrets locally; never commit real values.
JWT_ACCESS_SECRET=replace-locally
JWT_ACCESS_REFRESH=replace-locally
JWT_ACCESS_SECRET_EXPIRES_IN=900
JWT_ACCESS_REFRESH_EXPIRES_IN=604800
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
BULK_USER_IMPORT_BATCH_SIZE=250
BULK_USER_IMPORT_BCRYPT_CONCURRENCY=4
BULK_USER_IMPORT_JOB_CONCURRENCY=1
