# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
BASEPATH=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_PRO_URL=
NEXT_PUBLIC_REPO_NAME=
# Browser API origin, fixed at build time. The client adds /api.
NEXT_PUBLIC_API_URL=
# Server runtime only. Use HTTPS origins in production and the same key as Nest.
AUTH_PUBLIC_ORIGIN=
AUTH_API_ORIGIN=
AUTH_TRANSPORT_KEY=
# Required to present QR: trusted public HTTPS origin reachable by student phones (no path).
# Student reception route: /attendance/qr (explicit confirmation after login).
NEXT_PUBLIC_ATTENDANCE_QR_ORIGIN=

# Optional server-only header, set and overwritten by the trusted ingress, with a single IP.
PASSWORD_RECOVERY_CLIENT_IP_HEADER=
